  - m_Id: 551692160487424
    m_Localized: 'Has Muerto

'
    m_Metadata:
      m_Items: []
  - m_Id: 557984308547584
    m_Localized: Resumir
    m_Metadata:
      m_Items: []
  - m_Id: 581824858312704
    m_Localized: "Uff\u2026 qu\xE9 linda la brisa\u2026 me voy a quedar un ratito
      en la mecedora."
    m_Metadata:
      m_Items: []
  - m_Id: 581929443282944
    m_Localized: "Uy\u2026 que sue\xF1o\u2026 "
    m_Metadata:
      m_Items: []
  - m_Id: 581993309949952
    m_Localized: Tengo que... ?
    m_Metadata:
      m_Items: []
  - m_Id: 582098696032256
    m_Localized: Tengo que... cerrar el corr... ?
    m_Metadata:
      m_Items: []
  - m_Id: 594819768406016
    m_Localized: "Uy\u2026 me qued\xE9 dormido\u2026 \xBFya es de noche?"
    m_Metadata:
      m_Items: []
  - m_Id: 594885035970560
    m_Localized: "\xA1La gran siete! Dej\xE9 el corral abierto\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 594956599185408
    m_Localized: "Las ovejas se me habr\xE1n ido pa\u2019l campo."
    m_Metadata:
      m_Items: []
  - m_Id: 595039185031168
    m_Localized: Tengo que salir a buscarlas antes que se pierdan del todo.
    m_Metadata:
      m_Items: []
  - m_Id: 597078711488512
    m_Localized: ' '
    m_Metadata:
      m_Items: []
  - m_Id: 707139475623936
    m_Localized: "Fin.\n\xA1Gracias por jugar!"
    m_Metadata:
      m_Items: []
